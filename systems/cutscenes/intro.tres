[ext_resource type="Script" uid="uid://dksy8vb6aqdib" path="res://systems/cutscenes/cutscene_resource.gd" id="2"]
[ext_resource type="Texture2D" uid="uid://xrl51yjumlfg" path="res://assets/cutscenes/raven.png" id="3"]
[ext_resource type="Texture2D" uid="uid://c1ttmejkcsgmt" path="res://assets/cutscenes/letter.png" id="4"]
